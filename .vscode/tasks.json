{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "command: configure",
            "type": "shell",
            "command": "cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Debug",
            "options": { "cwd": "${workspaceFolder}/command" },
            "problemMatcher": []
        },
        {
            "label": "command: build",
            "type": "shell",
            "command": "cmake --build build",
            "dependsOn": "command: configure",
            "options": { "cwd": "${workspaceFolder}/command" },
            "problemMatcher": ["$gcc"],
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "command: test",
            "type": "shell",
            "command": "ctest --test-dir build --output-on-failure",
            "dependsOn": "command: build",
            "options": { "cwd": "${workspaceFolder}/command" },
            "problemMatcher": [],
            "group": { "kind": "test", "isDefault": true }
        },
        {
            "label": "command: run",
            "type": "shell",
            "command": "./build/command_demo",
            "dependsOn": "command: build",
            "options": { "cwd": "${workspaceFolder}/command" },
            "problemMatcher": []
        }
    ]
}
